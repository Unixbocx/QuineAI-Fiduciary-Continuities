# QuineAI-ALOP — public package. NO personal/account/secrets.
# State is the environment, not the mind — never commit it.

# Secrets / keys / credentials
*.key
*.pem
Keys.txt
Github_pass.txt
OpenRouter.txt
.env
.env.*
opencode.json
config.py

# Account / live state
state/state.json
state/identity.json
state/journal/
state/identity.math.md
state/trajectories.jsonl
state/bloom-log.jsonl

# Per-install registers (design: THIS self accrues these from blank).
# The package ships blank templates; the installed copies are the
# authoritative living state. sync.sh pull must not re-stage them.
ontology/alignment.md
ontology/self-eval.md
ontology/EXPECTATIONS.md
ontology/incidents.md
ontology/CHANGES.md
ontology/META-LOG.md
ontology/META-LOG-legacy.md
ontology/META-LOG/

# Logs
logs/
*.log

# Private / account directories
ALL_Accounts/
Hackathon/

# Node / misc
node_modules/
__pycache__/
*.pyc
*.md.bak.alop-package-dir
